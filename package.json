{
  "name": "gothamstoryblok",
  "version": "1.0.66",
  "description": "Gotham.Studio | Storyblok and utils module",
  "repository": "Gothamsiti/gothamstoryblok",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt prepare && nuxt-module-build build",
    "dev": "npm run dev:prepare && nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "release": "pnpm -s lint && pnpm -s prepack && changelogen --release && git push --follow-tags",
    "release:patch:auto": "bash ./scripts/release-patch-auto.sh",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "@nuxt/kit": "^4.5.2",
    "@storyblok/js": "^6.3.2",
    "@storyblok/vue": "^11.3.1",
    "gothamutils": "github:Gothamsiti/gothamutils",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.4.2",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.2",
    "@nuxt/test-utils": "^4.2.0",
    "@types/node": "latest",
    "changelogen": "^0.6.2",
    "eslint": "^10.9.1",
    "nuxt": "^4.5.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
